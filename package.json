{
  "name": "queacp",
  "private": true,
  "version": "0.2.1",
  "description": "Queue of Agent Cues — schedule your attention with a unified queue of waiting Agent sessions.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:acp && vite",
    "dev:que": "QUEACP_DATA_DIR=\"$HOME/.queacp-dev\" tauri dev",
    "build": "npm run build:acp && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "QUEACP_DATA_DIR=\"$HOME/.queacp-dev\" tauri dev",
    "build:acp": "node scripts/build-acp.mjs",
    "predev": "npm run build:acp",
    "test:acp": "npm run build:acp && node --test --test-timeout=120000 tests/acp/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "acpx": "0.19.3",
    "ansi_up": "^6.0.6",
    "diff": "^9.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "vite": "^8.0.16"
  },
  "license": "MIT"
}
