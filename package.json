{
  "name": "que",
  "private": true,
  "version": "0.2.0",
  "description": "Queue of Agent Cues — schedule your attention with a unified queue of waiting Agent sessions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:que": "QUE_DATA_DIR=\"$HOME/.que-dev\" tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "QUE_DATA_DIR=\"$HOME/.que-dev\" tauri dev --config src-tauri/tauri.dev.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "ansi_up": "^6.0.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "vite": "^8.0.16"
  },
  "license": "MIT"
}
