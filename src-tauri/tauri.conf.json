{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Que",
  "version": "0.2.1",
  "identifier": "app.que.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Que",
        "width": 1320,
        "height": 860,
        "minWidth": 880,
        "minHeight": 620,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 24, "y": 25 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com http://127.0.0.1:* http://localhost:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "resources": {
      "resources/bin/": "resources/bin/",
      "resources/terminal-palettes-LICENSE.txt": "resources/terminal-palettes-LICENSE.txt",
      "../examples/harness-extensions/qwen-code/": "resources/extensions/qwen-code/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
