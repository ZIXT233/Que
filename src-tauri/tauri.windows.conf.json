{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["msi", "nsis"],
    "icon": ["icons/windows/icon.ico"],
    "resources": [
      "resources/bin/**/*",
      "resources/conpty/**/*",
      "resources/terminal-palettes-LICENSE.txt"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Que",
        "width": 1320,
        "height": 860,
        "minWidth": 880,
        "minHeight": 620,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 24, "y": 25 },
        "decorations": false
      }
    ]
  }
}
